# --- Обязательные ---
DATABASE_URL=postgres://investnews:investnews@localhost:5432/investnews
# Длинная случайная строка: openssl rand -hex 32
PAYLOAD_SECRET=
# Публичный адрес сайта (без слэша в конце)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Поиск (Meilisearch) — подключается на следующем этапе ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me

# --- Файлы в Cloudflare R2 (если не задано — файлы хранятся локально в ./media) ---
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес бакета (custom domain R2), откуда сайт отдаёт картинки
S3_PUBLIC_URL=

# --- Рассылка Beehiiv (Settings → Integrations → API) ---
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- Аналитика GA4 — подключается вместе с cookie-баннером ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Интеграции — подключаются на этапе 4 ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
